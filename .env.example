# Modèle des variables d'environnement — AUCUNE valeur réelle ici.
# Copier en `.env` pour le développement local ; en ligne, les saisir dans Vercel (Settings → Environment Variables).
# Les variables NEXT_PUBLIC_* sont visibles par le navigateur : jamais de secret dedans.

# ── Base de données (Neon, Francfort) ──────────────────────────────
# Connexion poolée (PgBouncer), utilisée par l'application.
DATABASE_URL=
# Connexion directe, utilisée uniquement par les migrations Prisma.
DIRECT_URL=

# ── Site ───────────────────────────────────────────────────────────
# URL publique canonique (sans / final). Ex. http://localhost:3000 en local.
NEXT_PUBLIC_SITE_URL=
# Segment d'URL secret de l'admin (12 à 64 caractères a-z 0-9 -). Jamais « admin ».
# Générer : node -e "console.log('gestion-' + require('crypto').randomBytes(9).toString('hex'))"
ADMIN_PATH=

# ── Authentification admin (Better Auth, phase 4) ──────────────────
# Clé de signature des sessions. Générer : openssl rand -base64 32
AUTH_SECRET=
# URL de base de l'auth (= NEXT_PUBLIC_SITE_URL en général).
AUTH_URL=

# ── Secrets applicatifs ────────────────────────────────────────────
# Clé HMAC pour hacher les adresses IP (audit, rate limiting). openssl rand -base64 32
IP_HASH_SECRET=
# Clé de signature du cookie panier. openssl rand -base64 32
CART_COOKIE_SECRET=
# Secret attendu par les routes /api/cron/* (Vercel l'envoie automatiquement). 32 caractères min.
CRON_SECRET=

# ── Stripe (phase 3) — clés de TEST tant que la phase 8 n'est pas validée ──
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Emails (Resend, phase 3) ───────────────────────────────────────
RESEND_API_KEY=
# Expéditeur sur le domaine authentifié (SPF/DKIM/DMARC). Ex. "Boutique <commandes@domaine.fr>"
EMAIL_FROM=
# Destinataire des alertes (fulfillment, stock, marge, seuils).
ADMIN_ALERT_EMAIL=

# ── Fournisseurs (phase 5) ─────────────────────────────────────────
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_ACCESS_TOKEN=
CJ_API_KEY=

# ── Upstash (rate limiting + files de jobs) ────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# QStash : envoi des jobs fulfillment avec réessais, et clés de vérification de signature.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# ── Cloudflare Turnstile (anti-bot formulaires publics) ────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Vercel Blob (photos/vidéos produit, factures PDF) ──────────────
BLOB_READ_WRITE_TOKEN=

# ── Marketing (phase 6, uniquement après consentement) ─────────────
TIKTOK_PIXEL_ID=
TIKTOK_EVENTS_API_TOKEN=

# ── Sentry (région UE : de.sentry.io) ──────────────────────────────
# DSN serveur et DSN navigateur (même valeur ; un DSN n'est pas un secret).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build uniquement : envoi des source maps. Token secret, à ne mettre que dans Vercel/CI.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
